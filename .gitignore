.DS_Store
*.log
.tooling-state.json
.tmp/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Coverage
.coverage
htmlcov/

# pytest tmp_path basetemp (created when pytest runs with cwd at repo/worktree root)
pytest-of-*/

# Workflow state (ephemeral, per-repo)
.state/
!.state/.gitkeep

# Active workflow state (ephemeral ticket dirs). Vendored packs are tracked.
.orchestrator/*
!.orchestrator/workflows/
!.orchestrator/workflows/**

# Legacy per-change state location (kept so in-flight runs don't break)
spec/changes/*/state.yaml
spec/changes/*/plan.yaml

.env
n8n/.env
.mcp.json
# Tracked exception: contains only ${VAR} placeholders (no secrets); must clone
# into cloud sessions so the backlog MCP server exists there. See docs/cloud-environment.md.
!.mcp.json
.pricing-cache.json

# Cross-repo metrics runtime artifacts (per-machine, never gitted)
*.duckdb
*.duckdb.bak-*
/metrics-registry.yaml
.claude/metrics.jsonl

# Pi install wiring (generated by install.sh)
.pi/

# Workflow pack lives in its own repo (ugudlado/workflows, config/) — the local
# .orchestrator/workflows/ copy is installed/synced from there, not vendored.
.orchestrator/workflows/

# Skills live in their own repo (ugudlado/skills) and are installed here via
# `npx skills` — nothing under skills/ is vendored anymore
# (workflow-creator moved to that repo Aug 2026).
skills/
.agents/skills/
.claude/skills/backlog/

*.lock
!poetry.lock

# Python virtualenvs (e.g. ui/dashboard/.venv)
.venv/

# Node (prettier installs via pre-commit mirrors-prettier hook)
node_modules/

.tmp-pytest/

# Vendored pack noise (never ship optimizer caches / bytecode)
.orchestrator/workflows/**/__pycache__/
.orchestrator/workflows/**/runs/cache/
.orchestrator/workflows/**/*.pyc
.worktrees/

# pnpm content-addressable store (never commit)
.pnpm-store/

# Per-run engine scratch (Phase 2.1) — artifacts are kept, scratch never is
.orchestrator/runs/*/scratch/
