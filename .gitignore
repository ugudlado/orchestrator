.DS_Store
*.log
.tooling-state.json
.tmp/
.tmp-pytest/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Coverage
.coverage
htmlcov/

# pytest tmp_path basetemp (created when pytest runs with cwd at repo/worktree root)
pytest-of-*/

# Installed, not vendored: workflow pack, generated plugin dirs, per-run state
.orchestrator/

.env
.mcp.json
# Tracked exception: contains only ${VAR} placeholders (no secrets)
!.mcp.json
.claude/metrics.jsonl

# Skills live in their own repo (ugudlado/skills) and are installed via `npx skills`
skills/*
.agents/skills/

*.lock
!poetry.lock

.venv/
node_modules/
.worktrees/

.claude/settings.local.json
.claude/skills/find-skills
.claude/skills/systematic-debugging
.claude/skills/explorer
.claude/skills/designer
.claude/skills/developer
.claude/skills/code-reviewer
.claude/skills/design-reviewer
.claude/skills/commit-group
.claude/skills/orchestrate
.claude/skills/workflow-creator

# Local tool leftovers (not used by the engine)
.pi/
.pnpm-store/
*.duckdb
*.duckdb.bak-*
