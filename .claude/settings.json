{
  "enabledPlugins": {
    "agentmemory@agentmemory": true,
    "ponytail@ponytail": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agentmemory": {
      "source": {
        "source": "github",
        "repo": "rohitg00/agentmemory"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(curl:*)",
      "Bash(pip install:*)",
      "Bash(npm i:*)",
      "Bash(git push:*)",
      "Edit(./**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_context7_context7",
      "Edit(~/code/feature_worktrees/**)",
      "Read(~/code/feature_worktrees/**)",
      "Edit(~/.claude/logs/**)",
      "Read(~/.claude/logs/**)",
      "Read(~/.claude/projects/**)",
      "Edit(~/.claude/projects/**)",
      "Read(~/.claude/skills/**)",
      "Edit(~/.claude/skills/**)",
      "Read(~/.local/bin/**)"
    ],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "additionalWritePaths": ["~/.claude/logs", "~/code/feature_worktrees"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/cloud-setup.sh\""
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "simplify": "off",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "schedule": "name-only",
    "loop": "name-only",
    "keybindings-help": "name-only",
    "fewer-permission-prompts": "name-only",
    "plugin-authoring": "name-only"
  }
}
