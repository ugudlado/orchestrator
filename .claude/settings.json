{
  "enabledPlugins": {
    "agentmemory@agentmemory": true,
    "ponytail@ponytail": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agentmemory": {
      "source": {
        "source": "github",
        "repo": "rohitg00/agentmemory"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(curl:*)",
      "Bash(pip install:*)",
      "Bash(npm i:*)",
      "Bash(git push:*)",
      "Edit(./**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "mcp__chrome-devtools",
      "mcp__plugin_context7_context7",
      "mcp__plugin_claude-mem_mcp",
      "mcp__plugin_linear_linear",
      "mcp__drawio",
      "mcp__pal",
      "Edit(~/code/feature_worktrees/**)",
      "Read(~/code/feature_worktrees/**)",
      "Read(~/.config/orchestrator/**)",
      "Edit(~/.config/spec/**)",
      "Read(~/.config/spec/**)",
      "Edit(~/.claude/logs/**)",
      "Read(~/.claude/logs/**)",
      "Edit(~/.config/hooksmith/**)",
      "Read(~/.config/hooksmith/**)",
      "Edit(~/.config/linear/**)",
      "Read(~/.config/linear/**)",
      "Read(~/.claude/projects/**)",
      "Edit(~/.claude/projects/**)",
      "Read(~/.claude/skills/**)",
      "Edit(~/.claude/skills/**)",
      "Read(~/.local/bin/**)",
      "mcp__claude_ai_Linear"
    ],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "additionalWritePaths": [
      "~/.config/spec",
      "~/.config/hooksmith",
      "~/.config/linear",
      "~/.claude/logs",
      "~/code/feature_worktrees"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/cloud-setup.sh\""
          }
        ]
      }
    ]
  }
}
