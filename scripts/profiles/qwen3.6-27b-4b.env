# Qwen3.6-27B-AWQ-INT4 — architect/quality model.
# Dense 27B, vendor-reported 77.2% SWE-bench.
# Default GPU is A40 (cheapest fit). Override with GPU_TYPE for spikes:
#   GPU_TYPE="NVIDIA H100 80GB HBM3" PROFILE=qwen3.6-27b-awq gpu.sh create
POD_NAME="vllm-qwen27b"
CLOUD_TYPE="SECURE"
GPU_TYPE="NVIDIA A40"
GPU_FALLBACKS="NVIDIA RTX A6000,NVIDIA A100 80GB PCIe,NVIDIA H100 80GB HBM3"
VLLM_MODEL="cyankiwi/Qwen3.6-27B-AWQ-INT4"
VLLM_MAX_LEN=65536
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER="qwen3_coder"
VLLM_REASONING_PARSER=""
# Required on CUDA<12.6 hosts (RunPod stock pytorch 2.4 image).
# Safe everywhere; falls back to Triton GDN kernels. See H100_A100_FIXES.md.
VLLM_EXTRA_ARGS="--gdn-prefill-backend triton"
