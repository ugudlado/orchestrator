# Qwen3.6-35B-A3B 4-bit (AWQ) — developer/fast model.
# MoE: 30B total, 3B active per token. Vendor 73.4% SWE-bench.
# A40 measured 83 tok/s (3B-active means ~10% of weights read per token).
POD_NAME="vllm-qwen35b-a3b"
CLOUD_TYPE="SECURE"
GPU_TYPE="NVIDIA A40"
GPU_FALLBACKS="NVIDIA RTX A6000,NVIDIA A100 80GB PCIe,NVIDIA H100 80GB HBM3"
VLLM_MODEL="cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit"
VLLM_MAX_LEN=65536
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER="qwen3_coder"
VLLM_REASONING_PARSER=""
# Required on CUDA<12.6 hosts (RunPod stock pytorch 2.4 image).
# Safe everywhere; falls back to Triton GDN kernels. See H100_A100_FIXES.md.
VLLM_EXTRA_ARGS="--gdn-prefill-backend triton"
