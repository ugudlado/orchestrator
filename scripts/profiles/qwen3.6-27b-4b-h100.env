# Spike: Qwen3.6-27B 4-bit on H100 80GB.
# Same model as qwen3.6-27b-4b.env, different GPU + ephemeral disk.
# Measured 95 tok/s. See H100_A100_FIXES.md.
POD_NAME="vllm-qwen27b-h100"
CLOUD_TYPE="SECURE"
GPU_TYPE="NVIDIA H100 80GB HBM3"
GPU_FALLBACKS="NVIDIA H100 PCIe,NVIDIA H200"
VOLUME_NAME="none"
CONTAINER_DISK_GB=80
VLLM_MODEL="cyankiwi/Qwen3.6-27B-AWQ-INT4"
VLLM_MAX_LEN=65536
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER="qwen3_coder"
VLLM_REASONING_PARSER=""
VLLM_EXTRA_ARGS="--gdn-prefill-backend triton"
