# bench: 65 tok/s on Vast A100 SXM4
# Vast.ai spike: Qwen3.6-27B 4-bit on A100 SXM4 80GB.
# Same model as qwen3.6-27b-4b.env, rented direct from Vast (no gpu.sh provisioning).
# A100 SXM4 has ~2,039 GB/s HBM2e bandwidth (vs PCIe ~1,935). Predicted 70-95 tok/s.
# Pod is provisioned manually via Vast UI; setup-vllm.sh is run over SSH.
# See H100_A100_FIXES.md.
POD_NAME="vllm-qwen27b-vast"
VLLM_MODEL="cyankiwi/Qwen3.6-27B-AWQ-INT4"
VLLM_MAX_LEN=65536
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER="qwen3_coder"
VLLM_REASONING_PARSER=""
VLLM_EXTRA_ARGS="--gdn-prefill-backend triton"

# ---------------------------------------------------------------------------
# Vast.ai provisioning (used by gpu.sh vast create)
# ---------------------------------------------------------------------------

# Offer ID from the Vast marketplace.
# IMPORTANT: many "A100 SXM4" offers are 40GB cards.  The 27B model + 65K context
# does not fit in 40GB; you MUST verify gpu_ram>=80000 before using an offer.
# CLI search:
#   vastai search offers 'gpu_name=A100_SXM4 num_gpus=1 verified=true \
#     rentable=true gpu_ram>=80000' --order 'dph_total' --raw
# (Filter is recommended over the web UI which doesn't always show VRAM.)
VAST_OFFER_ID="33845176"

# Docker image for the pod.  Vast's `cuda-12.8.1-auto` tag bundles a recent
# PyTorch + CUDA 12.8.1 toolkit (satisfies flashinfer >= 0.6 GDN kernel JIT).
# List tags: curl -s 'https://hub.docker.com/v2/repositories/vastai/pytorch/tags'
VAST_IMAGE="vastai/pytorch:cuda-12.8.1-auto"

# Root disk size in GB.  100 GB minimum: model (~17 GB) + vLLM + Triton/HF caches.
VAST_DISK_GB=100

# Vast pods use /workspace as an overlay directory on the root disk (not a
# separate mount like RunPod network volumes).  setup-vllm.sh uses this path
# for HF cache, Triton cache, and the vLLM log file.
VOLUME_MOUNT_PATH=/workspace
