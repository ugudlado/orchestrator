# Spike: Qwen3.6-27B 4-bit on A100 80GB PCIe.
# Same model as qwen3.6-27b-4b.env, mid-tier bandwidth (~1935 GB/s).
# Predicted 65-90 tok/s. See H100_A100_FIXES.md.
POD_NAME="vllm-qwen27b-a100"
CLOUD_TYPE="SECURE"
GPU_TYPE="NVIDIA A100 80GB PCIe"
GPU_FALLBACKS="NVIDIA A100-SXM4-80GB"
VOLUME_NAME="none"
CONTAINER_DISK_GB=80
VLLM_MODEL="cyankiwi/Qwen3.6-27B-AWQ-INT4"
VLLM_MAX_LEN=65536
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER="qwen3_coder"
VLLM_REASONING_PARSER=""
VLLM_EXTRA_ARGS="--gdn-prefill-backend triton"
