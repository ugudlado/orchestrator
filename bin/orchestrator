#!/usr/bin/env python3
# requires: pyyaml, duckdb
# orchestrator — dispatcher CLI for the orchestrator workflow engine.
#
# Usage:
#   orchestrator next <state.yaml>
#
# Exit codes:
#   0 — action returned (run_step / run_inline / resume_step / verify_phase)
#   1 — complete_workflow
#   2 — blocked (escalate_to_architect or blocked status)
#   3 — error (malformed input, missing file, slug-guard failure)
"""
Entry point for the `orchestrator` CLI.

Adds config/scripts/ to sys.path so orchestrator_next can be imported as a
package regardless of where the CLI is invoked from.
"""
from __future__ import annotations

import os
import sys

# Resolve the worktree root from this file's location (bin/orchestrator → root).
# Use realpath() so a symlink on $PATH (e.g. ~/.local/bin/orchestrator → repo)
# resolves to the repo location, not the symlink location.
_BIN_DIR = os.path.dirname(os.path.realpath(__file__))
_WORKTREE_ROOT = os.path.dirname(_BIN_DIR)
_SCRIPTS_DIR = os.path.join(_WORKTREE_ROOT, "config", "scripts")

# Insert at position 0 so project modules take precedence over any installed packages.
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)


import re as _re
_SLUG_RE_BIN = _re.compile(r"^[a-z0-9][a-z0-9-]*$")


def _usage() -> None:
    print(
        "Usage:\n"
        "  orchestrator next <state.yaml>\n"
        "  orchestrator record <state.yaml>   # JSON payload on stdin\n"
        "  orchestrator cost --change-id <cid> [--by step|agent|tool] [--format md|json]\n"
        "  orchestrator cost --repo [--by feature|agent|tool|complexity] [--format md|json] [--since <ISO>]\n"
        "  orchestrator metrics --change-id <cid> [--format md|json]\n"
        "  orchestrator ingest-driver --change-id <cid> --session-id <uuid>\n"
        "  orchestrator ingest-subagents --change-id <cid> --session-id <uuid>\n"
        "  orchestrator doctor",
        file=sys.stderr,
    )
    sys.exit(3)


def _metrics_main(args: list[str]) -> None:
    """Handle `orchestrator metrics --change-id <cid> [--format md|json]` subcommand."""
    import argparse

    parser = argparse.ArgumentParser(prog="orchestrator metrics", add_help=False)
    parser.add_argument("--change-id", dest="change_id", default=None)
    parser.add_argument("--format", dest="fmt", default="md", choices=["md", "json"])

    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        print(
            "error: invalid flags for `orchestrator metrics`\n"
            "Usage:\n"
            "  orchestrator metrics --change-id <cid> [--format md|json]",
            file=sys.stderr,
        )
        sys.exit(3)

    if not parsed.change_id:
        print("error: --change-id is required", file=sys.stderr)
        sys.exit(3)

    if not _SLUG_RE_BIN.match(parsed.change_id):
        print(
            f"error: --change-id '{parsed.change_id}' violates slug guard. "
            f"Must match ^[a-z0-9][a-z0-9-]*$ (lowercase alphanumeric and hyphens only, "
            f"no leading hyphen).",
            file=sys.stderr,
        )
        sys.exit(3)

    # Resolve DB path
    db_path = os.environ.get("METRICS_DB") or (
        os.path.join(os.environ["ORCHESTRATOR_HOME"], "metrics.duckdb")
        if os.environ.get("ORCHESTRATOR_HOME")
        else None
    )
    if not db_path:
        print("error: METRICS_DB or ORCHESTRATOR_HOME must be set", file=sys.stderr)
        sys.exit(3)
    if not os.path.isfile(db_path):
        print(f"error: metrics.duckdb not found at {db_path}", file=sys.stderr)
        sys.exit(3)

    try:
        import duckdb
        from orchestrator_next.upsert import ensure_schema
        from orchestrator_next.metrics_report import (
            aggregate_metrics,
            render_metrics_json,
            render_metrics_md,
        )
    except ImportError as exc:
        print(f"error: failed to import modules — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        db = duckdb.connect(db_path, read_only=True)
    except Exception as exc:  # noqa: BLE001
        print(f"error: cannot open DB at {db_path} — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        # Resolve repo_root for this change_id from step_events
        row = db.execute(
            "SELECT repo_root FROM step_events WHERE change_id = ? LIMIT 1",
            [parsed.change_id],
        ).fetchone()
        if not row:
            print(
                f"error: no events for change_id={parsed.change_id}",
                file=sys.stderr,
            )
            sys.exit(3)
        repo_root = row[0]

        data = aggregate_metrics(db, repo_root, parsed.change_id)
        if parsed.fmt == "json":
            output = render_metrics_json(data)
        else:
            output = render_metrics_md(data)

    except Exception as exc:  # noqa: BLE001
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    finally:
        db.close()

    print(output, end="")
    sys.exit(0)


def _cost_main(args: list[str]) -> None:
    """Handle `orchestrator cost ...` subcommand."""
    import argparse

    parser = argparse.ArgumentParser(prog="orchestrator cost", add_help=False)
    parser.add_argument("--change-id", dest="change_id", default=None)
    parser.add_argument("--repo", action="store_true", default=False)
    parser.add_argument("--by", dest="by", default=None,
                        choices=["step", "agent", "tool", "feature", "complexity"])
    parser.add_argument("--format", dest="fmt", default="md", choices=["md", "json"])
    parser.add_argument("--since", dest="since", default=None)

    try:
        parsed = parser.parse_args(args)
    except SystemExit:
        print(
            "error: invalid flags for `orchestrator cost`\n"
            "Usage:\n"
            "  orchestrator cost --change-id <cid> [--by step|agent|tool] [--format md|json]\n"
            "  orchestrator cost --repo [--by feature|agent|tool|complexity] [--format md|json] [--since <ISO>]",
            file=sys.stderr,
        )
        sys.exit(3)

    # Mutual exclusion: exactly one of --change-id / --repo required
    if parsed.change_id and parsed.repo:
        print("error: --change-id and --repo are mutually exclusive", file=sys.stderr)
        sys.exit(3)
    if not parsed.change_id and not parsed.repo:
        print("error: one of --change-id or --repo is required", file=sys.stderr)
        sys.exit(3)

    # Slug guard for --change-id
    if parsed.change_id and not _SLUG_RE_BIN.match(parsed.change_id):
        print(
            f"error: --change-id '{parsed.change_id}' violates slug guard. "
            f"Must match ^[a-z0-9][a-z0-9-]*$ (lowercase alphanumeric and hyphens only, "
            f"no leading hyphen).",
            file=sys.stderr,
        )
        sys.exit(3)

    # --since only meaningful with --repo
    if parsed.since and parsed.change_id:
        print(
            "warning: --since is only meaningful with --repo; ignoring it",
            file=sys.stderr,
        )
        parsed.since = None

    # Resolve DB path
    db_path = os.environ.get("METRICS_DB") or (
        os.path.join(os.environ["ORCHESTRATOR_HOME"], "metrics.duckdb")
        if os.environ.get("ORCHESTRATOR_HOME")
        else None
    )
    if not db_path:
        print("error: METRICS_DB or ORCHESTRATOR_HOME must be set", file=sys.stderr)
        sys.exit(3)
    if not os.path.isfile(db_path):
        print(f"error: metrics.duckdb not found at {db_path}", file=sys.stderr)
        sys.exit(3)

    try:
        import duckdb
        from orchestrator_next.upsert import ensure_schema
        from orchestrator_next.cost_report import (
            aggregate_feature,
            aggregate_by_scope,
            aggregate_repo,
            render_markdown_feature,
            render_markdown_scoped,
            render_markdown_repo,
            render_json,
        )
    except ImportError as exc:
        print(f"error: failed to import modules — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        db = duckdb.connect(db_path, read_only=True)
    except Exception as exc:  # noqa: BLE001
        print(f"error: cannot open DB at {db_path} — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        if parsed.change_id:
            # Resolve repo_root from DB for this change_id
            row = db.execute(
                "SELECT repo_root FROM step_events WHERE change_id = ? LIMIT 1",
                [parsed.change_id],
            ).fetchone()
            if not row:
                print(
                    f"error: no events for change_id={parsed.change_id}",
                    file=sys.stderr,
                )
                sys.exit(3)
            repo_root = row[0]

            if parsed.by:
                data = aggregate_by_scope(db, repo_root, parsed.change_id, parsed.by)
                if parsed.fmt == "json":
                    output = render_json(data)
                else:
                    output = render_markdown_scoped(data, parsed.by)
            else:
                data = aggregate_feature(db, repo_root, parsed.change_id)
                if parsed.fmt == "json":
                    output = render_json(data)
                else:
                    output = render_markdown_feature(data)

        else:
            # --repo mode: use basename of $PWD
            repo_basename = os.path.basename(os.getcwd())
            data = aggregate_repo(db, repo_basename, since=parsed.since, scope=parsed.by)
            if not data["rows"]:
                print(
                    f"error: no events for repo basename={repo_basename}",
                    file=sys.stderr,
                )
                sys.exit(3)
            if parsed.fmt == "json":
                output = render_json(data)
            else:
                output = render_markdown_repo(data, scope=parsed.by)

    except Exception as exc:  # noqa: BLE001
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    finally:
        db.close()

    print(output, end="")
    sys.exit(0)


def _ingest_driver_main(args: list[str]) -> None:
    """Handle `orchestrator ingest-driver --change-id <cid> --session-id <uuid>`.

    Reads the driver JSONL at ~/.claude/projects/<slug>/<session>.jsonl,
    computes cost_usd via routes.yaml + the DuckDB pricing table, and upserts a synthetic
    step_events row with agent_name='driver-loop'. Idempotent via PK.

    Sub-agent enrichment is out of scope for this command — sub-agent rows
    are written by record.py during the workflow. Future enhancement: teach
    the driver to call extract_agent_usage(agent_id) right after an Agent
    spawn returns, so the record payload carries cache_creation and JSONL-
    truth numbers at write time (one ingestion path, no post-hoc enrichment).
    """
    change_id = None
    session_id = None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--change-id" and i + 1 < len(args):
            change_id = args[i + 1]; i += 2
        elif a == "--session-id" and i + 1 < len(args):
            session_id = args[i + 1]; i += 2
        else:
            _usage()
    if not change_id or not session_id:
        _usage()

    try:
        import duckdb
        from orchestrator_next.jsonl_usage import extract_driver_usage
        from orchestrator_next.upsert import ensure_schema, upsert_synthetic_event
        from orchestrator_next.record import _compute_cost_usd
    except ImportError as exc:
        print(f"error: failed to import orchestrator_next — {exc}", file=sys.stderr)
        sys.exit(3)

    repo_root = os.getcwd()
    try:
        repo_root = os.popen("git rev-parse --show-toplevel").read().strip() or repo_root
    except Exception:
        pass

    usage = extract_driver_usage(repo_root, session_id)
    if not usage:
        print(f'{{"ingested": false, "reason": "JSONL not found or empty for session {session_id}"}}')
        sys.exit(0)

    db_path = os.environ.get("METRICS_DB") or f"{repo_root}/metrics.duckdb"
    db = duckdb.connect(db_path)
    try:
        ensure_schema(db)

        # Compute cost_usd using DuckDB pricing table (driver-loop doesn't map to
        # an agent role, so pass the model we already extracted as the agent hint).
        # _compute_cost_usd prefers usage.model when present, which we have.
        model, cost = _compute_cost_usd(db, "driver-loop", usage)
        if cost is not None:
            usage["cost_usd"] = cost
        if model and not usage.get("model"):
            usage["model"] = model

        upsert_synthetic_event(
            db, {"repo_root": repo_root, "change_id": change_id},
            agent_name="driver-loop",
            step_id="driver-loop-turns",
            phase="meta",
            usage=usage,
        )
    finally:
        db.close()

    import json as _json
    print(_json.dumps({
        "ingested": True,
        "change_id": change_id,
        "session_id": session_id,
        "input_tokens": usage.get("input_tokens"),
        "output_tokens": usage.get("output_tokens"),
        "cache_read_input_tokens": usage.get("cache_read_input_tokens"),
        "cache_creation_input_tokens": usage.get("cache_creation_input_tokens"),
        "cost_usd": usage.get("cost_usd"),
        "model": usage.get("model"),
        "turns": usage.get("turns"),
    }))
    sys.exit(0)


def _ingest_subagents_main(args: list[str]) -> None:
    """Handle `orchestrator ingest-subagents --change-id <cid> --session-id <uuid>`.

    Discovers sub-agent JSONLs under ~/.claude/projects/<slug>/<session>/subagents/,
    reads each agent-<id>.meta.json sidecar for agentType, aggregates usage via
    extract_agent_usage(), and upserts one synthetic step_events row per sub-agent.
    Idempotent: skips agents whose rows already exist with non-zero input_tokens.

    Prints a single JSON summary line: {"ingested": N, "skipped": M, "agents": [...]}
    """
    import json as _json

    change_id = None
    session_id = None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--change-id" and i + 1 < len(args):
            change_id = args[i + 1]; i += 2
        elif a == "--session-id" and i + 1 < len(args):
            session_id = args[i + 1]; i += 2
        else:
            _usage()
    if not change_id or not session_id:
        _usage()

    try:
        import duckdb
        from orchestrator_next.jsonl_usage import discover_subagents, extract_agent_usage, locate_subagent_jsonl_path
        from orchestrator_next.upsert import ensure_schema, upsert_synthetic_event
        from orchestrator_next.record import _compute_cost_usd
    except ImportError as exc:
        print(f"error: failed to import orchestrator_next — {exc}", file=sys.stderr)
        sys.exit(3)

    repo_root = os.getcwd()
    try:
        repo_root = os.popen("git rev-parse --show-toplevel").read().strip() or repo_root
    except Exception:
        pass

    agent_ids = discover_subagents(repo_root, session_id)

    db_path = os.environ.get("METRICS_DB") or f"{repo_root}/metrics.duckdb"
    db = duckdb.connect(db_path)

    ingested = 0
    skipped = 0
    agents_summary = []

    try:
        ensure_schema(db)

        for agent_id in agent_ids:
            step_id = f"subagent-{agent_id}"

            # Read agentType from meta.json sidecar; fallback to "subagent-unknown"
            agent_name = "subagent-unknown"
            try:
                jsonl_path = locate_subagent_jsonl_path(repo_root, agent_id, driver_session_hint=session_id)
                if jsonl_path is not None:
                    meta_path = jsonl_path.parent / f"agent-{agent_id}.meta.json"
                    if meta_path.exists():
                        import json as _meta_json
                        meta = _meta_json.loads(meta_path.read_text())
                        agent_type = meta.get("agentType") or ""
                        if agent_type:
                            agent_name = agent_type
            except Exception:
                pass  # fallback remains "subagent-unknown"

            # Dedup: skip if row already exists with non-zero input_tokens (FR-6)
            existing = db.execute(
                "SELECT input_tokens FROM step_events "
                "WHERE repo_root=? AND change_id=? AND phase='meta' AND step_id=? AND attempt=1",
                [repo_root, change_id, step_id],
            ).fetchone()
            if existing is not None and existing[0] is not None and existing[0] > 0:
                skipped += 1
                agents_summary.append({
                    "agent_id": agent_id,
                    "agent_name": agent_name,
                    "status": "skipped",
                    "reason": "already_ingested",
                })
                continue

            # Extract usage from JSONL
            usage = extract_agent_usage(repo_root, agent_id, driver_session_hint=session_id)
            if not usage:
                skipped += 1
                agents_summary.append({
                    "agent_id": agent_id,
                    "agent_name": agent_name,
                    "status": "skipped",
                    "reason": "no_usable_turns",
                })
                continue

            # Compute cost via DuckDB pricing table (db already in scope)
            model, cost = _compute_cost_usd(db, agent_name, usage)
            if cost is not None:
                usage["cost_usd"] = cost
            if model and not usage.get("model"):
                usage["model"] = model

            upsert_synthetic_event(
                db, {"repo_root": repo_root, "change_id": change_id},
                agent_name=agent_name,
                step_id=step_id,
                phase="meta",
                usage=usage,
            )
            ingested += 1
            agents_summary.append({
                "agent_id": agent_id,
                "agent_name": agent_name,
                "status": "ingested",
                "reason": "",
            })

    finally:
        db.close()

    print(_json.dumps({"ingested": ingested, "skipped": skipped, "agents": agents_summary}))
    sys.exit(0)


def _append_in_progress_state_entry_if_absent(
    state_yaml_path: str,
    *,
    step_id: str,
    phase: str,
    attempt: int,
    agent: str,
    started_at: str,
) -> None:
    """Append an in_progress entry to state.yaml.step_history if not already present.

    Checks for an existing entry matching (step_id, phase, status='in_progress').
    If one already exists, returns without writing. Otherwise appends the new entry
    and writes back using the pre-write-bytes corruption guard (mirrored from
    record.py:399-414) to prevent corruption on write failure.

    This is a narrow state.yaml writer — separate from the main `record` writer.
    """
    import yaml as _yaml  # noqa: PLC0415 — lazily import; record already imported at top of its module

    with open(state_yaml_path, "rb") as _f:
        _pre_write_bytes = _f.read()

    try:
        _state_raw = _yaml.safe_load(_pre_write_bytes.decode("utf-8")) or {}
    except _yaml.YAMLError:
        # Pre-parse failure — do not write; let the next dispatch surface the corruption.
        return

    _history = list(_state_raw.get("step_history") or [])

    # Check if an in_progress entry already exists for (step_id, phase).
    for _e in _history:
        if (
            isinstance(_e, dict)
            and _e.get("step_id") == step_id
            and _e.get("phase") == phase
            and _e.get("status") == "in_progress"
        ):
            return  # already present — no write needed

    _history.append({
        "step_id": step_id,
        "phase": phase,
        "status": "in_progress",
        "agent": agent,
        "attempt": attempt,
        "started_at": started_at,
    })
    _state_raw["step_history"] = _history

    with open(state_yaml_path, "w") as _f:
        _yaml.safe_dump(_state_raw, _f, sort_keys=False, default_flow_style=False)

    # Post-write corruption guard: verify the written file is parseable.
    # If not, restore from pre-write bytes.
    try:
        with open(state_yaml_path) as _f:
            _yaml.safe_load(_f)
    except _yaml.YAMLError:
        with open(state_yaml_path, "wb") as _f:
            _f.write(_pre_write_bytes)


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] not in ("next", "record", "cost", "metrics", "doctor", "ingest-driver", "ingest-subagents"):
        _usage()
    if len(args) < 2 and args[0] in ("next", "record"):
        _usage()

    if args[0] == "cost":
        _cost_main(args[1:])
        return  # _cost_main calls sys.exit()

    if args[0] == "metrics":
        _metrics_main(args[1:])
        return  # _metrics_main calls sys.exit()

    if args[0] == "ingest-driver":
        _ingest_driver_main(args[1:])
        return  # exits

    if args[0] == "ingest-subagents":
        _ingest_subagents_main(args[1:])
        return  # exits

    if args[0] == "doctor":
        from orchestrator_next.doctor import _doctor_main
        sys.exit(_doctor_main(args[1:]))

    if args[0] == "record":
        from orchestrator_next.record import main as record_main
        sys.exit(record_main(sys.argv[1:]))

    state_yaml_path = args[1]

    try:
        from orchestrator_next.parser import load_state
        from orchestrator_next.dispatch import dispatch, emit_json
    except ImportError as exc:
        print(f"error: failed to import orchestrator_next — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        state = load_state(state_yaml_path)
    except FileNotFoundError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    except Exception as exc:  # noqa: BLE001 — catch-all for malformed YAML; diagnosed below
        print(f"error: failed to parse state.yaml — {exc}", file=sys.stderr)
        sys.exit(3)

    # Upsert terminal step_history entries into metrics.duckdb and reconcile
    # in_progress state against DB truth before dispatch.
    # DB path: METRICS_DB env var, falling back to $ORCHESTRATOR_HOME/metrics.duckdb.
    # Skip silently if ORCHESTRATOR_HOME is not set (test/offline mode).
    _metrics_db_path = os.environ.get("METRICS_DB") or (
        os.path.join(os.environ["ORCHESTRATOR_HOME"], "metrics.duckdb")
        if os.environ.get("ORCHESTRATOR_HOME")
        else None
    )
    _cost_so_far = 0.0
    _db = None
    try:
        if _metrics_db_path:
            import duckdb
            from orchestrator_next.upsert import (
                ensure_schema, upsert_step_event, sum_cost_usd,
                upsert_pending_step_event,
            )
            from orchestrator_next.reconcile import reconcile_in_progress

            _terminal_statuses = {"completed", "failed", "blocked", "escalate_to_architect"}
            _db = duckdb.connect(_metrics_db_path)
            ensure_schema(_db)
            _context = {"repo_root": state.repo_root, "change_id": state.change_id}
            for _entry in state.step_history:
                if _entry.status in _terminal_statuses:
                    try:
                        upsert_step_event(_db, _entry, _context)
                    except ValueError as _ve:
                        print(f"warning: upsert skipped — {_ve}", file=sys.stderr)
            try:
                _cost_so_far = sum_cost_usd(_db, _context)
            except Exception as _ce:  # noqa: BLE001 — cost query must not block dispatch
                print(f"warning: cost sum failed — {_ce}", file=sys.stderr)

            # Reconcile state.step_history against DB in_progress truth (DB wins).
            try:
                reconcile_in_progress(state, _db, _context)
            except Exception as _rce:  # noqa: BLE001 — reconcile must not block dispatch
                print(f"warning: reconcile failed — {_rce}", file=sys.stderr)
    except Exception as exc:  # noqa: BLE001 — DB errors must not block dispatch
        print(f"warning: step_events upsert/reconcile failed — {exc}", file=sys.stderr)

    # Outer try/finally guarantees _db.close() fires on both happy path and
    # dispatch exceptions. _db may be None if DB path was unavailable.
    try:
        try:
            action, exit_code = dispatch(state, state_yaml_path)
        except FileNotFoundError as exc:
            print(f"error: {exc}", file=sys.stderr)
            sys.exit(3)
        except Exception as exc:  # noqa: BLE001 — dispatch errors should be surfaced
            print(f"error: dispatch failed — {exc}", file=sys.stderr)
            sys.exit(3)

        # Post-dispatch pending write — gated by action verb.
        # Writes in_progress row to DB and appends matching state.yaml entry.
        _STEP_VERBS = {"run_step", "run_inline", "resume_step"}
        if _db is not None and action.get("action") in _STEP_VERBS:
            from datetime import datetime, timezone
            _started_at = action.get("started_at") or datetime.now(timezone.utc).isoformat()
            try:
                upsert_pending_step_event(
                    _db,
                    repo_root=state.repo_root,
                    change_id=state.change_id,
                    phase=action["phase"],
                    step_id=action["step_id"],
                    attempt=int(action["attempt"]),
                    agent_name=action.get("agent", "inline"),
                    started_at=_started_at,
                )
            except Exception as _upe:  # noqa: BLE001 — pending upsert must not block action emit
                print(f"warning: pending upsert failed — {_upe}", file=sys.stderr)
            try:
                _append_in_progress_state_entry_if_absent(
                    state_yaml_path,
                    step_id=action["step_id"],
                    phase=action["phase"],
                    attempt=int(action["attempt"]),
                    agent=action.get("agent", "inline"),
                    started_at=_started_at,
                )
            except Exception as _ape:  # noqa: BLE001 — state.yaml append must not block action emit
                print(f"warning: state.yaml pending append failed — {_ape}", file=sys.stderr)

        action["cost_so_far"] = _cost_so_far
        print(emit_json(action), end="")
    finally:
        if _db is not None:
            try:
                _db.close()
            except Exception:  # noqa: BLE001 — close failure must not mask dispatch result
                pass
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
