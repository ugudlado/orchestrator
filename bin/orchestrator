#!/usr/bin/env python3
# requires: pyyaml, duckdb
# orchestrator — dispatcher CLI for the orchestrator workflow engine.
#
# Usage:
#   orchestrator next <state.yaml>
#
# Exit codes (ORC-45 two-path dispatch protocol):
#   0 + JSON with agent key  — agent step; driver spawns Agent tool
#   0 + no JSON              — inline script ran and recorded; driver loops
#   1                        — workflow complete; driver reads state.yaml
#   2                        — step blocked; driver reads state.yaml
#   3                        — ContractDispatchError or other error
"""
Entry point for the `orchestrator` CLI.

Adds config/scripts/ to sys.path so orchestrator_next can be imported as a
package regardless of where the CLI is invoked from.
"""
from __future__ import annotations

import os
import sys

# Resolve the worktree root from this file's location (bin/orchestrator → root).
# Use realpath() so a symlink on $PATH (e.g. ~/.local/bin/orchestrator → repo)
# resolves to the repo location, not the symlink location.
_BIN_DIR = os.path.dirname(os.path.realpath(__file__))
_WORKTREE_ROOT = os.path.dirname(_BIN_DIR)
_SCRIPTS_DIR = os.path.join(_WORKTREE_ROOT, "config", "scripts")

# Insert at position 0 so project modules take precedence over any installed packages.
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)


import re as _re
_SLUG_RE_BIN = _re.compile(r"^[a-z0-9][a-z0-9-]*$")


def _inline_script_env(state, state_yaml_path: str, action_env: dict) -> dict:
    """Env for inline step scripts: always STATE_YAML_PATH/REPO_ROOT plus state fields.

    Merge order: os.environ, then action_env from orchestrator next, then state.yaml
    fields when non-empty. State wins over ambient env for CHANGE_ID, BRANCH,
    WORKTREE_PATH, WORKTREE_ROOT, ORCHESTRATOR_WORKFLOW_DIR, and ARCHIVE_PATH —
    intentional so dispatch context is authoritative, not the caller's shell.
    """
    raw = state.raw or {}
    env = {
        **os.environ,
        **action_env,
        "STATE_YAML_PATH": state_yaml_path,
        "REPO_ROOT": state.repo_root,
    }
    change_id = state.change_id or raw.get("slug") or ""
    if change_id:
        env["CHANGE_ID"] = change_id
    branch = raw.get("branch") or ""
    if branch:
        env["BRANCH"] = branch
    worktree = raw.get("worktree_path") or ""
    if worktree:
        worktree = os.path.expanduser(str(worktree))
        env["WORKTREE_PATH"] = worktree
        env["WORKTREE_ROOT"] = worktree
        env["ORCHESTRATOR_WORKFLOW_DIR"] = worktree
    archive_path = raw.get("archive_path") or ""
    if archive_path:
        env["ARCHIVE_PATH"] = archive_path
    return env


def _usage() -> None:
    print(
        "Usage:\n"
        "  orchestrator run <ticket-id> [--schema feature|bugfix] [--repo PATH] [flag=value ...]\n"
        "      Shell-driven full workflow (ticket check, seed if needed, run-workflow loop).\n"
        "  orchestrator next <state.yaml>\n"
        "  orchestrator done <state.yaml>   # JSON payload on stdin\n"
        "  orchestrator ready <state.yaml>  # JSON array of ready node ids\n"
        "  orchestrator graph <state.yaml>  # Mermaid flowchart of the phase DAG\n"
        "  orchestrator expand-plan <state.yaml>  # append task-nodes from tasks.yaml\n"
        "  orchestrator doctor",
        file=sys.stderr,
    )
    sys.exit(3)


def _run_verb(argv: list[str]) -> None:
    """`orchestrator run` — ticket-driven shell workflow (non-chat driver)."""
    import subprocess as _sp

    _run_sh = os.path.join(_WORKTREE_ROOT, "scripts", "orchestrator-run.sh")
    if not os.path.isfile(_run_sh):
        print(f"error: orchestrator-run.sh not found at {_run_sh}", file=sys.stderr)
        sys.exit(7)
    _proc = _sp.run(["bash", _run_sh, *argv])
    # Propagate run-workflow exit codes (1=complete is success for shell loops).
    raise SystemExit(_proc.returncode)


def _append_in_progress_state_entry_if_absent(
    state_yaml_path: str,
    *,
    step_id: str,
    phase: str,
    attempt: int,
    agent: str,
    started_at: str,
) -> None:
    """Append an in_progress entry to state.yaml.step_history if not already present.

    Checks for an existing entry matching (step_id, phase, status='in_progress').
    If one already exists, returns without writing. Otherwise appends the new entry
    and writes back using the pre-write-bytes corruption guard (mirrored from
    record.py:399-414) to prevent corruption on write failure.

    This is a narrow state.yaml writer — separate from the main `record` writer.
    """
    import yaml as _yaml  # noqa: PLC0415 — lazily import; record already imported at top of its module

    with open(state_yaml_path, "rb") as _f:
        _pre_write_bytes = _f.read()

    try:
        _state_raw = _yaml.safe_load(_pre_write_bytes.decode("utf-8")) or {}
    except _yaml.YAMLError:
        # Pre-parse failure — do not write; let the next dispatch surface the corruption.
        return

    _history = list(_state_raw.get("step_history") or [])

    # Check if an in_progress entry already exists for (step_id, phase).
    # Also skip the pre-stamp when a terminal entry (completed/failed/escalate_to_architect)
    # already exists for the same (step_id, phase, attempt) — the dispatcher saw the row
    # but a stale state read or path-resolution mismatch caused it to dispatch the same
    # step again. Pre-stamping in that case creates an orphan in_progress row at the
    # tail that masks the prior completion on the next `next` call.
    _TERMINAL_STATUSES = {"completed", "failed", "escalate_to_architect", "blocked"}
    for _e in _history:
        if not isinstance(_e, dict):
            continue
        if _e.get("step_id") != step_id or _e.get("phase") != phase:
            continue
        if _e.get("status") == "in_progress":
            return  # already present — no write needed
        if _e.get("status") in _TERMINAL_STATUSES and _e.get("attempt") == attempt:
            return  # terminal entry exists for this attempt — do not orphan it

    _history.append({
        "step_id": step_id,
        "phase": phase,
        "status": "in_progress",
        "agent": agent,
        "attempt": attempt,
        "started_at": started_at,
    })
    _state_raw["step_history"] = _history

    with open(state_yaml_path, "w") as _f:
        _yaml.safe_dump(_state_raw, _f, sort_keys=False, default_flow_style=False)

    # Post-write corruption guard: verify the written file is parseable.
    # If not, restore from pre-write bytes.
    try:
        with open(state_yaml_path) as _f:
            _yaml.safe_load(_f)
    except _yaml.YAMLError:
        with open(state_yaml_path, "wb") as _f:
            _f.write(_pre_write_bytes)


def _ready_verb(state_yaml_path: str) -> None:
    """`orchestrator ready` — print a JSON array of all ready node ids, exit 0.

    Read-only: no state.yaml write, no DuckDB.
    """
    import json as _json
    from orchestrator_next.parser import load_state
    from orchestrator_next import readiness
    try:
        state = load_state(state_yaml_path)
    except (FileNotFoundError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    print(_json.dumps(readiness.ready_nodes(state), sort_keys=True, indent=2))
    sys.exit(0)


def _graph_verb(state_yaml_path: str) -> None:
    """`orchestrator graph` — print a Mermaid flowchart of the phase DAG, exit 0.

    Read-only: no state.yaml write, no DuckDB.
    """
    from orchestrator_next.parser import load_state
    from orchestrator_next.graph import render_graph
    try:
        state = load_state(state_yaml_path)
    except (FileNotFoundError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    print(render_graph(state), end="")
    sys.exit(0)


def main() -> None:
    args = sys.argv[1:]
    # Stage C: ingest-driver and ingest-subagents removed from accepted verbs.
    # 'record' kept for silent backward-compat (one cycle) but absent from the banner.
    if not args or args[0] not in (
        "next", "done", "record", "ready", "graph", "doctor", "expand-plan", "run",
    ):
        _usage()
    if len(args) < 2 and args[0] in ("next", "record", "done", "ready", "graph", "expand-plan"):
        _usage()

    if args[0] == "run":
        _run_verb(args[1:])

    if args[0] == "doctor":
        from orchestrator_next.doctor import _doctor_main
        sys.exit(_doctor_main(args[1:]))

    if args[0] in ("record", "done"):
        from orchestrator_next.record import main as record_main
        sys.exit(record_main(sys.argv[1:]))

    # ORC-63: read-only DAG-visibility verbs — no state.yaml write, no DuckDB.
    if args[0] == "ready":
        _ready_verb(args[1])
    if args[0] == "graph":
        _graph_verb(args[1])

    # ORC-65: expand-plan verb — read tasks.yaml, append task-nodes to plan.
    if args[0] == "expand-plan":
        from orchestrator_next.expand_plan import expand_plan as _expand_plan
        try:
            _expand_plan(args[1])
        except FileNotFoundError as exc:
            print(f"error: {exc}", file=sys.stderr)
            sys.exit(1)
        except (ValueError, Exception) as exc:  # noqa: BLE001
            print(f"error: {exc}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    state_yaml_path = args[1]

    try:
        from orchestrator_next.parser import load_state, ContractDispatchError
        from orchestrator_next.dispatch import dispatch, emit_json
    except ImportError as exc:
        print(f"error: failed to import orchestrator_next — {exc}", file=sys.stderr)
        sys.exit(3)

    try:
        state = load_state(state_yaml_path)
    except FileNotFoundError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(3)
    except Exception as exc:  # noqa: BLE001 — catch-all for malformed YAML; diagnosed below
        print(f"error: failed to parse state.yaml — {exc}", file=sys.stderr)
        sys.exit(3)

    # Upsert terminal step_history entries into metrics.duckdb and reconcile
    # in_progress state against DB truth before dispatch.
    # DB path: METRICS_DB env var, falling back to $ORCHESTRATOR_HOME/metrics.duckdb.
    # Skip silently if ORCHESTRATOR_HOME is not set (test/offline mode).
    _metrics_db_path = os.environ.get("METRICS_DB") or (
        os.path.join(os.environ["ORCHESTRATOR_HOME"], "metrics.duckdb")
        if os.environ.get("ORCHESTRATOR_HOME")
        else None
    )
    _cost_so_far = 0.0
    _db = None
    try:
        if _metrics_db_path:
            import duckdb
            from orchestrator_next.upsert import (
                ensure_schema, upsert_step_event, sum_cost_usd,
                upsert_pending_step_event,
            )
            from orchestrator_next.reconcile import reconcile_in_progress

            _terminal_statuses = {"completed", "failed", "blocked", "escalate_to_architect"}
            _db = duckdb.connect(_metrics_db_path)
            ensure_schema(_db)
            _context = {"repo_root": state.repo_root, "change_id": state.change_id}
            for _entry in state.step_history:
                if _entry.status in _terminal_statuses:
                    try:
                        upsert_step_event(_db, _entry, _context)
                    except ValueError as _ve:
                        print(f"warning: upsert skipped — {_ve}", file=sys.stderr)
            try:
                _cost_so_far = sum_cost_usd(_db, _context)
            except Exception as _ce:  # noqa: BLE001 — cost query must not block dispatch
                print(f"warning: cost sum failed — {_ce}", file=sys.stderr)

            # Reconcile state.step_history against DB in_progress truth (DB wins).
            try:
                _pre_sig = tuple(
                    (e.phase, e.step_id, e.attempt, e.status)
                    for e in state.step_history
                )
                reconcile_in_progress(state, _db, _context)
                _post_sig = tuple(
                    (e.phase, e.step_id, e.attempt, e.status)
                    for e in state.step_history
                )
                if _post_sig != _pre_sig:
                    try:
                        import yaml as _yaml
                        from pathlib import Path as _Path

                        _path = _Path(state_yaml_path)
                        with open(_path, "rb") as _f:
                            _pre_bytes = _f.read()
                        _state_raw = _yaml.safe_load(_pre_bytes.decode("utf-8")) or {}
                        _state_raw["step_history"] = [e.raw for e in state.step_history]
                        with open(_path, "w", encoding="utf-8") as _f:
                            _yaml.safe_dump(
                                _state_raw,
                                _f,
                                sort_keys=False,
                                default_flow_style=False,
                                allow_unicode=True,
                            )
                        try:
                            with open(_path, "r", encoding="utf-8") as _f:
                                _yaml.safe_load(_f)
                        except _yaml.YAMLError:
                            with open(_path, "wb") as _f:
                                _f.write(_pre_bytes)
                    except Exception as _pe:  # noqa: BLE001
                        print(
                            f"warning: reconcile persistence failed — {_pe}",
                            file=sys.stderr,
                        )
            except Exception as _rce:  # noqa: BLE001 — reconcile must not block dispatch
                print(f"warning: reconcile failed — {_rce}", file=sys.stderr)
    except Exception as exc:  # noqa: BLE001 — DB errors must not block dispatch
        print(f"warning: step_events upsert/reconcile failed — {exc}", file=sys.stderr)

    # Outer try/finally guarantees _db.close() fires on both happy path and
    # dispatch exceptions. _db may be None if DB path was unavailable.
    try:
        try:
            action, exit_code = dispatch(state, state_yaml_path)
        except FileNotFoundError as exc:
            print(f"error: {exc}", file=sys.stderr)
            sys.exit(3)
        except ContractDispatchError as exc:
            # step has neither agent: nor run: — exit 3 with diagnostic
            print(str(exc), file=sys.stderr)
            sys.exit(3)
        except Exception as exc:  # noqa: BLE001 — dispatch errors should be surfaced
            print(f"error: dispatch failed — {exc}", file=sys.stderr)
            sys.exit(3)

        # Exit 1 (complete) or exit 2 (blocked) — no JSON, just close DB and exit.
        if exit_code in (1, 2):
            sys.exit(exit_code)  # finally block will close _db

        # --- Agent path (exit 0 + JSON with agent key) ---
        if action.get("agent"):
            # Post-dispatch pending write — agent step entering in_progress.
            if _db is not None:
                from datetime import datetime, timezone
                _started_at = action.get("started_at") or datetime.now(timezone.utc).isoformat()
                try:
                    upsert_pending_step_event(
                        _db,
                        repo_root=state.repo_root,
                        change_id=state.change_id,
                        phase=action["phase"],
                        step_id=action["step_id"],
                        attempt=int(action["attempt"]),
                        agent_name=action["agent"],
                        started_at=_started_at,
                    )
                except Exception as _upe:  # noqa: BLE001 — pending upsert must not block action emit
                    print(f"warning: pending upsert failed — {_upe}", file=sys.stderr)
                try:
                    _append_in_progress_state_entry_if_absent(
                        state_yaml_path,
                        step_id=action["step_id"],
                        phase=action["phase"],
                        attempt=int(action["attempt"]),
                        agent=action["agent"],
                        started_at=_started_at,
                    )
                except Exception as _ape:  # noqa: BLE001 — state.yaml append must not block action emit
                    print(f"warning: state.yaml pending append failed — {_ape}", file=sys.stderr)

            # Emit JSON with cost_so_far; driver spawns Agent tool.
            action["cost_so_far"] = _cost_so_far
            print(emit_json(action), end="")
            sys.exit(0)  # finally block will close _db

        # --- Inline script path (exit 0 + no JSON) ---
        if action.get("run"):
            import subprocess as _sp
            from orchestrator_next.record import record as _record

            # Close DB before running inline script — the script may need read-only
            # access (e.g. compute-swe-metrics) and DuckDB blocks concurrent access.
            if _db is not None:
                try:
                    _db.close()
                except Exception:  # noqa: BLE001
                    pass
                _db = None

            _run_path = action["run"]
            # Resolve relative paths: prefer contract dir (ORC-76 AC-2), else
            # fall back to $ORCHESTRATOR_HOME/config/ (legacy behavior).
            if not os.path.isabs(_run_path):
                _step_contract_dir = action.get("step_contract_dir")
                if _step_contract_dir:
                    _run_path = os.path.join(_step_contract_dir, _run_path)
                else:
                    _orchestrator_home = os.environ.get("ORCHESTRATOR_HOME") or _WORKTREE_ROOT
                    _run_path = os.path.join(_orchestrator_home, "config", _run_path)

            _script_env = _inline_script_env(state, state_yaml_path, action.get("env", {}))

            _step_id = action["step_id"]
            _phase = action["phase"]
            _attempt = action["attempt"]

            def _stderr_step_log(msg: str) -> None:
                from datetime import datetime
                print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}", file=sys.stderr)

            _stderr_step_log(
                f"→ {_step_id}  phase={_phase}  kind=inline script  attempt={_attempt}"
            )
            _stderr_step_log(f"  run: {_run_path}")

            # State-mutating inline steps move/delete state.yaml as their side
            # effect (complete-workflow's archive phase rm -rf's the state
            # directory). record() re-opens state_yaml_path to read pre-write
            # bytes — if the script has already moved the file, that raises
            # FileNotFoundError. Fix: record these steps as completed BEFORE
            # running the script, so the step_history entry is durable in
            # state.yaml at its current location; the script then moves the
            # already-final file.
            #
            # Two ids are state-mutating:
            #   - complete-workflow: the terminal step for feature/bugfix; its
            #     archive phase rm -rf's the state dir.
            #   - archive-completed-change: still the terminal step for the
            #     spike schema (spike.yaml), which ORC-79 left untouched. Its
            #     script rm -rf's the state dir the same way, so it keeps its
            #     pre-record protection.
            #
            # Tradeoff: a state-mutating step records `completed` before its
            # script's exit code is known. The archive phase's hardened
            # `cp ... || exit 1` ensures a failed copy exits non-zero BEFORE the
            # `rm -rf`, so the source dir (with the optimistic entry) stays
            # intact and the driver halts on exit 3 — recoverable, not
            # catastrophic. The script's own outputs (commit_sha etc.) are not
            # threaded into step_history; that is the accepted cost.
            _STATE_MUTATING_INLINE_STEPS = {
                "archive-completed-change",
                "complete-workflow",
            }
            _state_mutating = _step_id in _STATE_MUTATING_INLINE_STEPS

            if _state_mutating:
                _record(
                    state_yaml_path,
                    {
                        "step_id": _step_id,
                        "phase": _phase,
                        "attempt": _attempt,
                        "status": "completed",
                        "outputs": {},
                        "evidence": {"summary": "recorded pre-script (state-mutating inline step)"},
                    },
                    db=_db,
                )

            _proc = _sp.run(
                ["bash", _run_path],
                capture_output=True,
                env=_script_env,
            )
            # Forward script stderr to our stderr so operator can see it
            if _proc.stderr:
                sys.stderr.buffer.write(_proc.stderr)
                sys.stderr.buffer.flush()

            if _proc.returncode != 0:
                # State-mutating steps already recorded above; do not re-record
                # (record.py appends, it does not replace — a second entry would
                # leave completed+failed in history and race the node flip).
                if not _state_mutating:
                    _record(
                        state_yaml_path,
                        {
                            "step_id": _step_id,
                            "phase": _phase,
                            "attempt": _attempt,
                            "status": "failed",
                            "outputs": {},
                            "evidence": {"summary": f"script exited {_proc.returncode}"},
                        },
                        db=_db,
                    )
                # Surface script failure via stderr; exit 3 signals script error
                _stderr_step_log(f"✗ {_step_id}  failed  script_exit={_proc.returncode}")
                print(f"error: inline script failed (exit {_proc.returncode}): {_run_path}", file=sys.stderr)
                sys.exit(3)  # finally block will close _db
            else:
                # State-mutating steps already recorded pre-script.
                if not _state_mutating:
                    _stdout_lines = _proc.stdout.decode(errors="replace").strip().splitlines()
                    _outputs = {}
                    if _stdout_lines:
                        try:
                            import json as _json
                            _outputs = _json.loads(_stdout_lines[-1])
                        except (_json.JSONDecodeError, ValueError):
                            pass
                    _record(
                        state_yaml_path,
                        {
                            "step_id": _step_id,
                            "phase": _phase,
                            "attempt": _attempt,
                            "status": "completed",
                            "outputs": _outputs,
                            "evidence": {"outputs": _outputs, "summary": "inline script completed"},
                        },
                        db=_db,
                    )
                _stderr_step_log(f"✓ {_step_id}  done  status=completed")
                # No JSON on stdout — driver loops by calling orchestrator next again
                sys.exit(0)  # finally block will close _db

    finally:
        if _db is not None:
            try:
                _db.close()
            except Exception:  # noqa: BLE001 — close failure must not mask dispatch result
                pass
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
