#!/usr/bin/env python3
"""Dev-checkout shim — wheel installs use the `orchestrator` console script.

realpath() so a symlink on $PATH (e.g. ~/.local/bin/orchestrator → repo)
resolves to the checkout, whose orchestrator_next package must win over any
installed copy.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from orchestrator_next.cli import main

main()
