     "change_type": [
      "feature",
      "fix",
      "quick",
      "await_input"
     ]
    },
    "fail_on": {},
    "skip_when_unchanged": true,
    "routes": [
     {
      "when": {
       "change_type": "fix"
      },
      "goto": "diagnose"
     },
     {
      "when": {
       "change_type": "quick"
      },
      "goto": "quick-signoff"
     }
    ]
   },
